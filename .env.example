# AutoSpark — Environment Template
# Copy to .env and fill values. Never commit .env

# Supabase (required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Appwrite (required for payments)
VITE_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your_project_id
VITE_APPWRITE_DATABASE_ID=your_db_id
VITE_APPWRITE_COLLECTION_ID=your_collection_id
VITE_APPWRITE_FUNCTION_ID=sslcommerz-api

# Payment API (optional — falls back to https://autosparkbd.com/api/payment/init)
VITE_PAYMENT_API_URL=https://autosparkbd.com
VITE_PAYMENT_INIT_URL=

# Server-only (NEVER prefix with VITE — set in Vercel/server env, not .env client):
SSLCOMMERZ_STORE_ID=autosparkbd0live
SSLCOMMERZ_STORE_PASSWORD=69DBB19BAB55E48107
SSLCZ_IS_LIVE=true
SITE_URL=https://autosparkbd.com
#
# IPN listener (configure in SSLCommerz merchant panel → My Store → IPN Settings):
#   POST https://autosparkbd.com/api/payment/ipn
#
# SparkAI -> Groq (server-only; used by api/sparkai/chat.ts + server/dev-server.js)
# Get a key at https://console.groq.com/keys
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-20b
#
# Order + lead persistence (server-only; used by api/_db.ts)
# Prefer Neon: DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# Fallback (legacy): SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
# DATABASE_URL=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Local development notes:
#  - server/dev-server.js auto-loads this .env file
#  - Vite proxies /api/* to http://localhost:8787 (see vite.config.ts)
#  - Run the full stack with: npm run dev:full

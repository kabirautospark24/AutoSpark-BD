# AutoSpark BD — Environment Template
# Copy to .env and fill values. Never commit .env (it is gitignored).
# Values below are PLACEHOLDERS. See docs/development/environment.md for details.

# ---------------------------------------------------------------------------
# Client (VITE_*) — bundled into the browser. Never put secrets here.
# All are optional: the app falls back to same-origin /api routes.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

VITE_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your_project_id
VITE_APPWRITE_DATABASE_ID=your_db_id
VITE_APPWRITE_COLLECTION_ID=your_collection_id
VITE_APPWRITE_FUNCTION_ID=sslcommerz-api

# Payment API base (optional — falls back to https://autosparkbd.com)
VITE_PAYMENT_API_URL=https://autosparkbd.com
VITE_PAYMENT_INIT_URL=

# ---------------------------------------------------------------------------
# Server-only (set in Vercel project env / Appwrite function env — NEVER VITE_)
# ---------------------------------------------------------------------------
# SSLCommerz gateway (used by api/payment/* and server/dev-server.js)
# Get credentials from https://merchant.sslcommerz.com → My Store
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWORD=your_store_password
SSLCZ_IS_LIVE=true
SITE_URL=https://autosparkbd.com
#
# IPN listener (configure in SSLCommerz merchant panel → My Store → IPN Settings):
#   POST https://autosparkbd.com/api/payment/ipn
#
# SparkAI -> Groq (used by api/sparkai/chat.ts + server/dev-server.js)
# Get a key at https://console.groq.com/keys
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-20b
#
# Order + lead persistence (used by api/_db.ts)
# Prefer Neon: DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# Fallback (legacy): SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
# DATABASE_URL=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Local development notes:
#  - server/dev-server.js auto-loads this .env file
#  - Vite proxies /api/* to http://localhost:8787 (see vite.config.ts)
#  - Run the full stack with: npm run dev:full

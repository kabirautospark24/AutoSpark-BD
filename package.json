{
  "name": "autospark",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "homepage": "https://www.autosparkbd.com",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently \"node server/dev-server.js\" \"npm run dev\"",
    "dev:api": "node server/dev-server.js",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build && node scripts/prerender.mjs",
    "build:assets": "node scripts/generate-favicons.mjs",
    "serve:dist": "node scripts/serve-dist.mjs",
    "check:console": "node scripts/check-console.mjs",
    "check:bundle": "node scripts/measure-payload.cjs",
    "check": "npm run typecheck:all && npm run lint && npm run test:run",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"api/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.{mjs,cjs,js}\" \"*.{json,js,ts,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"api/**/*.ts\" \"tests/**/*.ts\"",
    "preview": "vite preview",
    "audit:deps": "npm audit --audit-level=high",
    "audit:pa11y": "npx pa11y http://127.0.0.1:4173 --standard wcag2aa --timeout 20000 > pa11y-report.txt",
    "audit:lighthouse": "npx lighthouse http://127.0.0.1:4173 --only-categories=performance,accessibility,best-practices,seo --output=json --output-path=lh-report.json --chrome-flags='--headless'",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:api": "tsc --noEmit -p tsconfig.api.json",
    "typecheck:all": "npm run typecheck && npm run typecheck:api",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "proxy": "node server/proxy.cjs",
    "postinstall": "node scripts/fix-three-types.cjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^5.2.2",
    "@neondatabase/serverless": "^1.2.0",
    "@react-three/drei": "^9.109.2",
    "@react-three/fiber": "^8.16.8",
    "@supabase/supabase-js": "^2.101.1",
    "appwrite": "^24.1.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "framer-motion": "^12.35.0",
    "gsap": "^3.14.2",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^1.3.0",
    "react-hook-form": "^7.72.0",
    "react-router-dom": "^7.13.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "three": "~0.163.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.35.0",
    "@testing-library/react": "^14.0.0",
    "@types/body-parser": "^1.19.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.163.0",
    "@vercel/node": "^28.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "body-parser": "^1.20.9",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "express": "^4.22.1",
    "gh-pages": "^6.3.0",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "prettier": "^3.4.2",
    "rollup-plugin-visualizer": "^5.9.1",
    "sharp": "^0.35.5",
    "sslcommerz-lts": "^1.2.0",
    "supabase": "^2.84.6",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^1.1.5"
  },
  "overrides": {
    "tar": "^7.5.13"
  }
}
